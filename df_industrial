      "source": [
        "# 1. Extraemos solo las columnas 'latitud' y 'longitud'.\n",
        "coords_df = df_industrial[['latitud', 'longitud']]\n",
        "\n",
        "# 2. El Rayos X de tus datos\n",
        "print(\"--- TIPO DE DATO Y NULOS ---\")\n",
        "# .info() te dice si son texto (object) o números con decimales (float64)\n",
        "print(coords_df.info())\n",
        "\n",
        "print(\"\\n--- VALORES FALTANTES ---\")\n",
        "# .isna().sum() cuenta cuántos parques industriales NO tienen coordenadas\n",
        "print(coords_df.isna().sum())\n",
        "\n",
        "print(\"\\n--- RESUMEN ESTADÍSTICO ---\")\n",
        "# .describe() nos da el mínimo y máximo. Crucial para ver si estamos en Nuevo León.\n",
        "# Si el min y max de la longitud son positivos (ej. 100.3), tenemos un problema grave.\n",
        "print(coords_df.describe())\n",
