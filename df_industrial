      "source": [
        "# 1. Conectar Google Drive a Colab\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# 2. Leer el archivo desde Google Drive\n",
        "# Asegúrate de que el nombre del archivo al final sea exactamente el que subiste\n",
        "ruta_raw = '/content/drive/MyDrive/Proyecto_ZMM/data_raw/denue_inegi_19_.csv'\n",
        "\n",
        "# Leemos el archivo\n",
        "print(\"Leyendo DENUE, paciencia...\")\n",
        "df_nl = pd.read_csv(ruta_raw, encoding='latin-1', low_memory=False)\n",
        "print(f\"Tamaño original: {df_nl.shape}\")\n",
        "\n",
        "# 3. Filtrar ZMM\n",
        "claves_zmm = [6, 18, 19, 21, 26, 31, 39, 41, 45, 46, 47, 48, 49]\n",
        "df_zmm = df_nl[df_nl['cve_mun'].isin(claves_zmm)].copy()\n",
        "print(f\"Tamaño después de filtrar ZMM: {df_zmm.shape}\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 4. El Filtro Industrial (SCIAN)\n",
        "# Convertimos la columna a texto por si pandas la leyó como número\n",
        "df_zmm['codigo_act'] = df_zmm['codigo_act'].astype(str)\n",
        "\n",
        "# Definimos los códigos 31-33 para Industrias manufactureras y 48-49 Transportes, correos y almacenamiento\n",
        "codigos_objetivo = ('31', '32', '33', '48', '49')\n",
        "\n",
        "# Filtramos usando startswith (si empieza con 31, 32, etc., se queda)\n",
        "df_industrial = df_zmm[df_zmm['codigo_act'].str.startswith(codigos_objetivo)].copy()\n",
        "print(f\"Tamaño final de Parques e Industrias: {df_industrial.shape}\")\n",
        "\n",
        "# 5. Guardar los datos procesados en Drive\n",
        "ruta_processed = '/content/drive/MyDrive/Proyecto_ZMM/data_processed/denue_industrial_zmm.csv'\n",
        "df_industrial.to_csv(ruta_processed, index=False)\n",
        "print(f\"¡Éxito! Archivo guardado en: {ruta_processed}\")"
      ],
